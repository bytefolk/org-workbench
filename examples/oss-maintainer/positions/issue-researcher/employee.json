{
  "$schema": "https://raw.githubusercontent.com/fullstack-ai-infra/digital-employee/main/configs/employee-package.schema.json",
  "schemaVersion": "employee-package.v1alpha1",
  "name": "issue-researcher",
  "version": "0.1.0",
  "description": "Triages issues and produces researched, evidence-backed summaries for the owner.",
  "license": "Apache-2.0",
  "authors": [
    "your-team"
  ],
  "host": {
    "protocol": "agent-host.v1",
    "requiredCapabilities": []
  },
  "entrypoints": {
    "skill": "./SKILL.md",
    "inputSchema": "./schemas/input.schema.json",
    "outputSchema": "./schemas/output.schema.json"
  },
  "policy": {
    "mode": "read_only",
    "network": "deny",
    "filesystem": {
      "read": [
        "./knowledge/**"
      ],
      "write": []
    },
    "mcpTools": []
  },
  "assets": [
    "./knowledge/README.md",
    "./evals/cases.json"
  ]
}
